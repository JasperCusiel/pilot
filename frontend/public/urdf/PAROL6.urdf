<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom 6-DOF arm, converted for the "pilot" web commander (urdf-loader).

  Changes from robot_arm_urdf.xacro (kinematics are unchanged):
    - Plain URDF: xacro namespace/include removed, ${...} math evaluated to numbers
    - Removed leading whitespace before the XML declaration
    - Joints and links renamed to L1..L6 (the app hard-codes these names)
    - Mesh paths changed from package://my_package/meshes/... to ./meshes/...
      (relative to /urdf/, same as the original PAROL6.urdf). Filenames are kept
      exactly as in your xacro (base.stl, j1.stl ... j5.stl), lowercase.
    - base_joint origin changed from "1 1 0" to "0 0 0": the app reports TCP
      positions from the world frame, so the base must sit at the origin.
    - Mesh scale="0.01 0.01 0.01" kept (urdf-loader supports it).

  Place at: frontend/public/urdf/PAROL6.urdf
  Meshes:   frontend/public/urdf/meshes/
-->
<robot name="robot">

  <link name="world"/>

  <!-- Base -->
  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <mesh filename="./meshes/base.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <!-- Joint 1 (was joint_1) -->
  <joint name="L1" type="revolute">
    <parent link="base_link"/>
    <child link="L1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="1.5" lower="-1.0471975512" upper="1.0471975512"/>
  </joint>

  <link name="L1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="./meshes/j1.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <!-- Joint 2 (was joint_2) -->
  <joint name="L2" type="revolute">
    <parent link="L1"/>
    <child link="L2"/>
    <origin xyz="0.047 0 0.135" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="1.5" lower="-1.3194689145" upper="1.5707963268"/>
  </joint>

  <link name="L2">
    <visual>
      <origin xyz="-0.047 0 -0.135" rpy="0 0 0"/>
      <geometry>
        <mesh filename="./meshes/j2.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <!-- Joint 3 (was joint_3) -->
  <joint name="L3" type="revolute">
    <parent link="L2"/>
    <child link="L3"/>
    <origin xyz="0 0 0.110" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="1.5" lower="-1.5707963268" upper="1.2566370614"/>
  </joint>

  <link name="L3">
    <visual>
      <origin xyz="-0.047 0 -0.245" rpy="0 0 0"/>
      <geometry>
        <mesh filename="./meshes/j3.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <!-- Joint 4 (was joint_4) -->
  <joint name="L4" type="revolute">
    <parent link="L3"/>
    <child link="L4"/>
    <origin xyz="0 0 0.026" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" velocity="1.5" lower="-4.7123889804" upper="4.7123889804"/>
  </joint>

  <link name="L4">
    <visual>
      <origin xyz="-0.047 0 -0.271" rpy="0 0 0"/>
      <geometry>
        <mesh filename="./meshes/j4.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <!-- Joint 5 (was joint_5) -->
  <joint name="L5" type="revolute">
    <parent link="L4"/>
    <child link="L5"/>
    <origin xyz="0.1175 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="1.5" lower="-1.8849555922" upper="1.8849555922"/>
  </joint>

  <link name="L5">
    <visual>
      <origin xyz="-0.1645 0 -0.271" rpy="0 0 0"/>
      <geometry>
        <mesh filename="./meshes/j5.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <!-- Joint 6 (was joint_6). Link L6 has no mesh (the app strips the L6 mesh anyway);
       the app reads the TCP pose from this link's frame. -->
  <joint name="L6" type="continuous">
    <parent link="L5"/>
    <child link="L6"/>
    <origin xyz="0.0268 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <link name="L6"/>

</robot>
